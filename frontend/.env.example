# ===========================================================================
# Fixsi frontend configuration (frontend/.env). Never commit .env.
# For local dev you can skip this file: the dev server proxies /api to the backend on :8000.
# ===========================================================================

# Backend URL, inlined at build time, e.g. https://fixsi-backend.onrender.com (no trailing slash). Set it on Vercel; empty = same origin /api.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api, e.g. http://127.0.0.1:8000. Change it only if the backend runs elsewhere.
VITE_PROXY_TARGET=http://127.0.0.1:8000
