{
  "name": "fixsi-backend",
  "version": "1.0.0",
  "description": "Fixsi API: an autonomous debugging agent that proves the root cause with a failing test before it fixes anything.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch-path=src src/server.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "setup:demo-shop": "node demo-shop/setup-history.js data/demo-shop-repo",
    "record:replays": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/record-replays.js",
    "list:models": "node scripts/list-models.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "zod": "4.6.7"
  }
}
