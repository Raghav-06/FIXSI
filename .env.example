# ===========================================================================
# Fixsi configuration. Never commit .env.
#
# Quick start:
#   1. cp .env.example .env
#   2. Fill in the REQUIRED section below (an empty NEBIUS_API_KEY = Replay mode: recorded demo runs only)
#   3. cd backend && npm install && npm run dev      (API on http://localhost:8000)
#   4. cd frontend && npm install && npm run dev     (UI on http://localhost:5173)
# ===========================================================================


# ###########################################################################
# REQUIRED: fill these in (for live mode)
# ###########################################################################

# Token Factory key for the Nemotron models, e.g. v1.abc123... Get it at tokenfactory.nebius.com → API keys. Empty = Replay mode.
NEBIUS_API_KEY=

# HMAC secret for webhooks and "Break it" (16+ chars, e.g. 64 hex chars). Run `openssl rand -hex 32`. Empty = both disabled.
WEBHOOK_SECRET=


# ###########################################################################
# RECOMMENDED: check these
# ###########################################################################

# Fast tier (triage, summaries), e.g. nvidia/nemotron-3-nano-30b-a3b. Check with `cd backend && npm run list:models`.
NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Main tier (hypotheses, tests, fixes), e.g. nvidia/nemotron-3-super-120b-a12b. Check with `cd backend && npm run list:models`.
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Hard tier (diagnosing failed fixes), e.g. nvidia/nemotron-3-ultra-550b-a55b. Check with `cd backend && npm run list:models`.
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Comma-separated browser origins allowed to call the API. When deployed, add your Vercel URL, e.g. https://fixsi.vercel.app.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ###########################################################################
# OPTIONAL: safe to leave as is
# ###########################################################################

# --- Model API -------------------------------------------------------------
# OpenAI-compatible base URL of Token Factory. Only change it if Nebius gives you a different endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Seconds before a single model call times out, e.g. 120. Raise it if Ultra calls time out.
LLM_TIMEOUT_SECONDS=120
# true = ask for OpenAI JSON mode first (falls back to plain JSON parsing), e.g. false. Try true if replies fail to parse.
LLM_USE_JSON_MODE=false

# --- GitHub PRs (also enables "GitHub issue" runs) -------------------------
# Opens real PRs, e.g. github_pat_... Fine-grained token with Contents + Pull requests read/write on the target repo only.
GITHUB_TOKEN=
# Owner of the target repo, e.g. your GitHub username. Publish it with backend/scripts/publish-demo-shop.sh.
GITHUB_REPO_OWNER=
# Name of the target repo, e.g. demo-shop.
GITHUB_REPO_NAME=demo-shop
# Branch PRs are opened against, e.g. main.
GITHUB_BASE_BRANCH=main

# --- Nebius Serverless Jobs (used only when SANDBOX_MODE=nebius_jobs) ------
# Project for sandbox jobs, e.g. project-e00abc... From the Nebius console; needs the `nebius` CLI installed and authenticated.
NEBIUS_JOBS_PROJECT_ID=
# Container image the tests run in, e.g. node:22-slim. Any public image with Node 22+.
NEBIUS_JOBS_IMAGE=node:22-slim
# CPU platform for test runs, e.g. cpu-d3. See the VM types page for your region.
NEBIUS_JOBS_PLATFORM=cpu-d3
# CPU preset for test runs, e.g. 4vcpu-16gb. See the VM types page for your region.
NEBIUS_JOBS_PRESET=4vcpu-16gb
# Subnet for jobs, e.g. vpcsubnet-e00abc... Empty = the project's default subnet.
NEBIUS_JOBS_SUBNET_ID=
# Path to the nebius CLI binary, e.g. nebius (a .js path is run with node).
NEBIUS_CLI_PATH=nebius
# Max seconds to wait for a job (startup + run) before falling back to local, e.g. 900.
NEBIUS_JOBS_TIMEOUT_SECONDS=900

# --- Agent limits ------------------------------------------------------------
# Hypotheses Fixsi may test per run, 2–8, e.g. 4.
MAX_HYPOTHESES=4
# Fix attempts after a hypothesis is confirmed, 1–10, e.g. 3.
MAX_FIX_ATTEMPTS=3
# Hard cap on prompt + completion tokens per run, e.g. 250000. The run stops when it is reached.
MAX_TOKENS_PER_RUN=250000
# Max size in bytes of a pasted error, stack trace and logs, e.g. 50000.
MAX_INPUT_BYTES=50000

# --- Sandbox -----------------------------------------------------------------
# Where tests run: local | nebius_jobs, e.g. local. nebius_jobs falls back to local if unavailable.
SANDBOX_MODE=local
# Seconds before a local test run is killed, e.g. 120.
SANDBOX_TIMEOUT_SECONDS=120
# Per-run copies of the target repo, e.g. ./data/workspaces. Relative paths are relative to backend/.
WORKSPACES_DIR=./data/workspaces
# Repo Fixsi debugs, e.g. ./data/demo-shop-repo. Built from backend/demo-shop/ (with git history) on startup if missing.
TARGET_REPO_PATH=./data/demo-shop-repo
# Source of the victim app and its incidents, e.g. /abs/path/to/demo-shop (use an absolute path). Default: backend/demo-shop.
# DEMO_SHOP_SOURCE=

# --- Public demo protection --------------------------------------------------
# Live runs each IP may start per hour, e.g. 5. Replays don't count.
RATE_LIMIT_RUNS_PER_HOUR=5
# Live runs allowed at the same time across all visitors, e.g. 2.
MAX_CONCURRENT_RUNS=2
# true = demo incidents always play recorded runs, even with a key, e.g. false. Automatic when NEBIUS_API_KEY is empty.
REPLAY_MODE=false
# Replay playback speed, e.g. 1.0 (recorded timing) or 2.0 (twice as fast).
REPLAY_SPEED=1.0

# --- Server ------------------------------------------------------------------
# SQLite file for run history (node:sqlite), e.g. sqlite:///./data/fixsi.db. Relative to backend/.
DATABASE_URL=sqlite:///./data/fixsi.db
# Port the API listens on, e.g. 8000. Hosts like Render set it for you.
# PORT=8000
# Interface to bind, e.g. 0.0.0.0. Empty = all interfaces (IPv4 and IPv6).
# HOST=


# ###########################################################################
# Deploying
# ###########################################################################
# Render (backend): set NEBIUS_API_KEY, WEBHOOK_SECRET and CORS_ALLOWED_ORIGINS (= your Vercel URL);
#   add GITHUB_* and anything from OPTIONAL only if you change it. render.yaml lists these already.
# Vercel (frontend): set only VITE_API_BASE_URL = the backend URL, e.g. https://fixsi-backend.onrender.com
#   (see frontend/.env.example). Redeploy the frontend after changing it; it is inlined at build time.
