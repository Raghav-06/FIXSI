# ---------------------------------------------------------------------------
# Fixsi configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Nebius Token Factory (OpenAI-compatible) ------------------------------
# Get a key at https://tokenfactory.nebius.com -> API keys.
# Leave NEBIUS_API_KEY empty to run in Replay mode (recorded demo runs only).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron model IDs per routing tier. Verify the exact IDs in the
# Token Factory model catalog (or: cd backend && npm run list:models).
NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Per-request timeout (seconds) for LLM calls.
LLM_TIMEOUT_SECONDS=120
# Try OpenAI JSON mode (response_format=json_object) first; falls back to plain JSON parsing.
LLM_USE_JSON_MODE=false

# --- Agent limits -----------------------------------------------------------
MAX_HYPOTHESES=4
MAX_FIX_ATTEMPTS=3
# Hard cap on prompt+completion tokens per investigation run.
MAX_TOKENS_PER_RUN=250000

# --- Sandbox ------------------------------------------------------------------
# local | nebius_jobs  (nebius_jobs falls back to local automatically if unavailable)
SANDBOX_MODE=local
SANDBOX_TIMEOUT_SECONDS=120
# Where per-run workspace copies of the target repo live (relative paths are relative to backend/).
WORKSPACES_DIR=./data/workspaces
# Target repo Fixsi debugs. Built from backend/demo-shop/ (with git history) on startup if missing.
TARGET_REPO_PATH=./data/demo-shop-repo

# Nebius Serverless Jobs sandbox (used when SANDBOX_MODE=nebius_jobs).
# Requires the `nebius` CLI installed and authenticated (nebius profile create).
NEBIUS_JOBS_PROJECT_ID=
NEBIUS_JOBS_IMAGE=node:22-slim
# CPU platform/preset for test runs, e.g. cpu-d3 / 4vcpu-16gb (check the VM types page for your region).
NEBIUS_JOBS_PLATFORM=cpu-d3
NEBIUS_JOBS_PRESET=4vcpu-16gb
# Optional; defaults to the project's default subnet.
NEBIUS_JOBS_SUBNET_ID=
# Path to the nebius CLI binary (a .js path is run with node).
NEBIUS_CLI_PATH=nebius
# Max seconds to wait for a job (startup + run) before falling back to local.
NEBIUS_JOBS_TIMEOUT_SECONDS=900

# --- GitHub (optional: open PRs + github_issue runs) ------------------------
# Fine-grained token with Contents + Pull requests (read/write) on the target repo only.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=demo-shop
GITHUB_BASE_BRANCH=main

# --- Webhooks ---------------------------------------------------------------
# Shared secret for HMAC-SHA256 signatures in the X-Fixsi-Signature header.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Public demo protection ------------------------------------------------
RATE_LIMIT_RUNS_PER_HOUR=5
MAX_CONCURRENT_RUNS=2
# true = demo incidents always play recorded runs (also automatic when no API key).
REPLAY_MODE=false
# Playback speed multiplier for replays (1.0 = recorded timing).
REPLAY_SPEED=1.0

# --- Server -----------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# SQLite database (node:sqlite), relative to backend/.
DATABASE_URL=sqlite:///./data/fixsi.db

# --- Frontend (frontend/.env) ----------------------------------------------
# VITE_API_BASE_URL=   empty = same origin; the Vite dev server and nginx image proxy /api to the backend.
